# Optional developer override. Default: configured Jcuki Supabase Edge Function.
# Never put private tokens in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=

# Public Expo/EAS project UUID used to register activity push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional public Supabase Auth configuration. Defaults target the Jcuki project.
# Use a publishable key; never a service_role or secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
