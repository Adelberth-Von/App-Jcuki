{
  "expo": {
    "name": "JCuki",
    "slug": "jcuki",
    "scheme": "jcuki",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8F5",
    "locales": {
      "id": "./assets/locales/id.json",
      "en": "./assets/locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "com.terrence.jcuki",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "id",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.terrence.jcuki",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#185F50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 33,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F5",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#101A16"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#185F50",
          "defaultChannel": "jcuki-reminders-v1",
          "sounds": [
            "./assets/sounds/jcuki_chime.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your gallery to personalize your JCuki profile. Only the photo you select is used.",
          "cameraPermission": false,
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#185F50",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackgroundColor": "#F7F8F5"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#192720",
              "cropToolbarIconColor": "#F1F6F0",
              "cropToolbarActionTextColor": "#8FDAB5",
              "cropBackgroundColor": "#101A16"
            }
          }
        }
      ],
      "./plugins/withAgendaWidget.cjs",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.terrence.jcuki.widgets",
          "groupIdentifier": "group.com.terrence.jcuki",
          "widgets": [
            {
              "name": "JCukiAgenda",
              "displayName": "JCuki days off",
              "description": "Your next confirmed day off and optional playing hours.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "signature": "Develop by Terrence"
    }
  }
}
